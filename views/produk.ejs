<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section class="page-header">
      <h1>Semua Produk</h1>
      <p>Temukan kebutuhan sembako Anda melalui pencarian atau filter kategori di bawah ini.</p>
    </section>

    <section class="filter-section" aria-labelledby="filter-heading">
      <h2 id="filter-heading" class="sr-only">Filter Produk</h2>
      <form id="filterForm" class="filter-form">
        <div class="form-group">
          <label for="search">Cari nama produk</label>
          <input type="text" id="search" name="search" placeholder="Contoh: beras" />
        </div>

        <div class="form-group">
          <label for="kategori">Kategori</label>
          <select id="kategori" name="kategori">
            <option value="">Semua kategori</option>
            <!-- opsi kategori diisi otomatis lewat JS dari data /api/products -->
          </select>
        </div>

        <div class="form-group form-actions">
          <button type="submit" class="btn btn-primary">Terapkan Filter</button>
          <button type="button" id="resetFilterBtn" class="btn btn-outline">Reset</button>
        </div>
      </form>
    </section>

    <section class="product-list-section" aria-labelledby="list-heading">
      <h2 id="list-heading" class="sr-only">Daftar Produk</h2>
      <div class="product-grid" id="productGrid">
        <!-- diisi lewat JS dari GET /api/products -->
      </div>
    </section>
  </main>

  <script id="icons-data" type="application/json"><%- JSON.stringify(iconsMap) %></script>
  <%- include('partials/footer') %>
  <script src="/js/produk.js"></script>
</body>
</html>
