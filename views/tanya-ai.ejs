<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section class="page-header">
      <h1>Tanya AI</h1>
      <p>Punya pertanyaan seputar produk atau rekomendasi belanja? Tanyakan di sini.</p>
    </section>

    <section class="chat-section" aria-labelledby="chat-heading">
      <h2 id="chat-heading" class="sr-only">Ruang Percakapan</h2>

      <div class="chat-window" id="chatWindow" role="log" aria-live="polite">
        <div class="chat-bubble chat-bubble-ai">
          <p>Halo! Saya asisten toko (masih versi sederhana). Coba tanya soal jam buka, ongkir, cara bayar, atau stok produk. 🙂</p>
        </div>
      </div>

      <div id="chatError" class="form-error" role="alert" hidden></div>

      <form id="chatForm" class="chat-form" novalidate>
        <div class="form-group">
          <label for="pertanyaan">Tulis pertanyaan Anda</label>
          <textarea
            id="pertanyaan"
            name="pertanyaan"
            rows="3"
            placeholder="Contoh: jam buka toko jam berapa?"
          ></textarea>
        </div>
        <button type="submit" class="btn btn-primary" id="chatSubmitBtn">Kirim Pertanyaan</button>
      </form>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/chat.js"></script>
</body>
</html>
